<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>MyBatis</title>
</head>
<body>
    <h1>회원 목록</h1>

	<table border="1">
		<thead>
			<tr>
				<th>ID</th>
				<th>이름</th>
				<th>이메일</th>
				<th>나이</th>
			</tr>
		</thead>
		<tbody>
			<c:forEach var="c" items="list" >
				<tr>
					<td>${list.id}</td>
					<td>${list.name}</td>
					<td>${list.email}</td>
					<td>${list.age}</td>
				</tr>
			</c:forEach>
		</tbody>
	</table>
</body>
</html>