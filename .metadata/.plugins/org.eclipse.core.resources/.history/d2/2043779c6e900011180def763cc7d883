package com.kh.spring.test;

import org.apache.catalina.connector.Request;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;

import jakarta.servlet.http.HttpSession;

@Controller
@RequestMapping("/test")
public class ResponseTestController {

	/*
	 * @ResponseBody : 화면없이 결과를 바로 텍스트로 응답.
	 * 
	 */
	@ResponseBody
	@GetMapping
	public String responseBodyTest() {
		return "결과를 텍스트로 응답";
	}
	
	@GetMapping("/index")
	public String responseIndex() {
//		prefix, suffix
//		{prefix} 리턴값 {suffix}
//		=> /WEB-INF/views/페이지경로.jsp 이 파일을 ViewResolver가 매칭시켜 응답해줄것
//		return "포워드 처리할 페이지 경로";
		return "test/index";
	}
	
	@GetMapping("/model-forward")
	public String modelForwardTest(Model model) {
		model.addAttribute("message", "Model을 통해 데이터 저장함");
		
		return "test/modelTest";
	}
	
	@GetMapping("/session/set")
	public String sessionTest(HttpSession session) {
		session.setAttribute("user", "김동주");
		
		return "redirect:/test/session";
	}
	
	@GetMapping("/session")
	public String viewSessionTest(HttpSession session, Request req) {
		String user = (String) session.getAttribute("user");
		
	}
}
