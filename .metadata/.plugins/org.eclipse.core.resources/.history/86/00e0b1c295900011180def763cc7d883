<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
	
	<head>
		<meta charset="UTF-8">
		<title>Member</title>
		<body>
			
			<h1>Member 리스트 페이지</h1>
			
			<table>
				<thead>
					<tr>
						<th>No</th>
						<th>이름</th>
						<th>이메일</th>
						<th>나이</th>
					</tr>
				</thead>
				<tbody>
					<c:if test="${empty memberList}">
						<p>등록된 회원이 없습니다</p>	
					 </c:if>
					<c:forEach var="member" items="${memberList}">
						<td> ${member.id}</td>
						<td> ${member.name}</td>
						<td> ${member.email}</td>
						<td> ${member.age}</td>
					</c:forEach>
				</tbody>
			</table>
			
		</body>
	</head>
</html>