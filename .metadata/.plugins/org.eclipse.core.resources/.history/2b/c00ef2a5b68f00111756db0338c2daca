package com.kh.spring.test;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;

import jakarta.servlet.http.HttpServletRequest;


/*
 *@Controller : 요청을 받기 위한 클래스에서 설정. 기본적으로 @Component 기능이 포함
 *
 * @Component : 이 어노테이션이 설정된 클래스는 스프링이 생성 및 삭제 등 관리를 수행.
 * 				스프링이 객체를 만들 클래스들을 모아놓은 목록을 Bean Factory라고 함.
 * 				스프링은 빈 팩토리에 등록된 클래스로만 객체를 생성해서 활용할 수 있음.
 * 				@Component를 사용하면 해당 클래스를 빈으로 등록해서 스프링이 사용할 수 있음.
 */


@Controller
@RequestMapping("/test")		//주소 매핑. 해당 컨트롤러의 모든 메소드 호출 시 앞에 붙는 주소. 
@ResponseBody  					//메서드의 return 값을 view가 아니라 HTTP 응답 body에 직접 텍스트로 보냄
public class RequestTestController {
//	@RestContoller  => @Controller + @ResponseBody
	@GetMapping("/servlet-request")
	public String servletRequestTest(HttpServletRequest req) {
		String userId = req.getParameter("userId");
		int age = Integer.parseInt("age");
		
		return "servletRequest 응답: " + userId + ", " + age;
	}
}
